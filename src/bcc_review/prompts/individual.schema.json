{
  "$comment": "Ответ этапа individual (№05). Строгая схема для structured outputs: additionalProperties=false, полный required. Перечни criterion и kind подставляются из criteria.toml и contracts.FINDING_KINDS при сборке запроса. Пустая строка или none — поле не применимо к статусу.",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["req_id", "checks"],
        "properties": {
          "req_id": {"type": "string"},
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion", "status", "reason", "quote", "condition", "outcomes", "impact", "fix",
                           "question", "severity", "kind", "blocks", "blocked_decision", "scenario", "root_cause"],
              "properties": {
                "criterion": {"type": "string", "enum": []},
                "status": {"type": "string", "enum": ["pass", "issue", "unknown", "na"]},
                "reason": {"type": "string"},
                "quote": {"type": "string"},
                "condition": {"type": "string"},
                "outcomes": {"type": "array", "items": {"type": "string"}},
                "impact": {"type": "string"},
                "fix": {"type": "string"},
                "question": {"type": "string"},
                "severity": {"type": "string", "enum": ["critical", "major", "minor", "none"]},
                "kind": {"type": "string", "enum": []},
                "blocks": {"type": "string", "enum": ["implement", "verify", "both", "none"]},
                "blocked_decision": {"type": "string"},
                "scenario": {"type": "string"},
                "root_cause": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
