+def test_exported_option_keeps_owner_wording_after_regeneration():
+    text = "Ровно пять дней допускаются."
+    original = recheck.load_answers("Q-01 [Срок выплаты]: [вариант A] " + text)
+    question = dict(QS[0], topic="Срок выплаты", options=["Нужно шесть дней.", text])
+    same = recheck.resolve_answers([question], original)["answered"][0]
+    assert (same["choice"], same["answer"]) == ("B", text)
+    question["options"] = ["При пяти днях вернуть отказ.", "При пяти днях принять."]
+    changed = recheck.resolve_answers([question], original)["answered"][0]
+    assert (changed["choice"], changed["answer"]) == ("", text)
+
+
+def test_exported_option_can_start_like_a_letter_answer():
+    result = recheck.parse_answers_text("Q-01: [вариант B] А — решение владельца.")
+    assert result["answers"][0]["text"] == "А — решение владельца."
+    assert result["answers"][0]["choice"] is None
+
+
