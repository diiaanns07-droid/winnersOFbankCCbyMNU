+@pytest.mark.parametrize("second_line", [14, 15])
+def test_neighboring_quotes_can_support_two_different_owner_conflicts(second_line):
+    old = {
+        "id": "D-17", "title": "Архив заявки удаляется в разные сроки",
+        "problem": "Срок хранения архива указан как пять и как семь лет.",
+        "evidence": [
+            {"line_start": 12, "quote": "Хранить архив пять лет."},
+            {"line_start": 14, "quote": "Удалить архив через семь лет."},
+        ],
+    }
+    unrelated = [
+        {"line_start": 12, "quote": "Уведомление передаётся письмом."},
+        {"line_start": second_line, "quote": "Телефон для извещения не используется."},
+    ]
+    assert recheck.duplicate_of(unrelated, [old], "Новый канал доставки извещения") == ""
+    assert recheck.duplicate_of(old["evidence"], [old], "Повтор замечания") == "D-17"
