+    """Команды из паспорта сохраняют относительные пути и скрывают каталоги конкретной машины."""
+    from pathlib import PurePosixPath, PureWindowsPath
+
+    def portable(value):
+        if not value:
+            return None
+        text = str(value)
+        windows = PureWindowsPath(text)
+        path = windows if windows.drive or "\\" in text else PurePosixPath(text)
+        return PurePosixPath(path.name if path.anchor else path.as_posix())
+
+    def command_arg(path):
+        text = path.as_posix().replace(chr(96), "").replace("|", "\\|")
+        return text if re.fullmatch(r"[\w./:-]+", text) else f'"{text}"'
+
+    out = portable(getattr(c, "out_path", None))
+    out_json = out.with_suffix(".json") if out else None
+    given = portable(getattr(c, "doc_path", None))
+    source = portable(c.doc.get("file"))
+    if source is None:
+        source = given if given else PurePosixPath("документ")
+    doc = given if given and given.name == source.name else PurePosixPath(source.name)
+    return out_json, command_arg(out_json or PurePosixPath("отчёт.json")), command_arg(doc)
 
 
