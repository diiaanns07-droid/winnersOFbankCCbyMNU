@@ -792,3 +792,26 @@ def test_latin_terms_in_final_texts():
 def test_summary_minors_have_owner_question():
     for spec in (judge._NO_IDS, judge._NONSINGULAR, judge._DUPLICATES, judge._PLACEHOLDERS):
         assert spec["question"].endswith("?")
+
+
+def test_owner_answer_is_a_separate_judge_source(monkeypatch):
+    captured = []
+    monkeypatch.setattr(judge, "_ask", lambda ctx, system, user, schema: captured.append((system, user)))
+    sample = cand("C-007", 20, "Обычный срок указан в регламенте.", source="recheck")
+    decision = "Новый срок при закрытии составляет восемнадцать дней."
+    sample["answer_refs"] = [{"id": "Q-09", "text": decision}]
+    judge._call_judge(Ctx(), [sample], [["C-007"]], "", [])
+    system, user = captured[0]
+    assert "файл ответов владельца" in system and decision not in system
+    assert '"Q-09"' in user and decision in user and '"C-007"' in user
+
+
+def test_initial_judge_cannot_use_candidate_text_as_owner_input(monkeypatch):
+    captured = []
+    monkeypatch.setattr(judge, "_ask", lambda ctx, system, user, schema: captured.append((system, user)))
+    sample = cand("C-008", 20, "Обычный срок указан в регламенте.")
+    sample["answer_refs"] = [{"id": "Q-21", "text": "Сторонняя версия ответа."}]
+    judge._call_judge(Ctx(), [sample], [["C-008"]], "", [])
+    system, user = captured[0]
+    assert "файл ответов владельца" not in system
+    assert "Сторонняя версия ответа." not in user
