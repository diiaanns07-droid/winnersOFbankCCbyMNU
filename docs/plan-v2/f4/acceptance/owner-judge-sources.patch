diff --git a/src/bcc_review/v2/stages/judge.py b/src/bcc_review/v2/stages/judge.py
index 59d89cdf..4eb85d3a 100644
--- a/src/bcc_review/v2/stages/judge.py
+++ b/src/bcc_review/v2/stages/judge.py
@@ -699,6 +699,20 @@ def _call_judge(ctx: Any, cands: list[dict], clusters: list[list[str]], checklis
     compact = len(cands) > COMPACT_THRESHOLD
     block = render_candidates(cands, clusters, compact)
     system, user = _build_messages(ctx, block, checklist, len(cands), compact, part)
+    owner_answers = [
+        {"candidate": c["id"], "answer": ref["id"], "text": ref["text"]}
+        for c in cands if c.get("source") == "recheck"
+        for ref in c.get("answer_refs") or []
+        if isinstance(ref, dict) and ref.get("id") and isinstance(ref.get("text"), str) and ref["text"].strip()
+    ]
+    if owner_answers:
+        system += ("\nРежим пересмотра. Проверяй помеченные кандидаты по двум источникам: исходное ТЗ и файл ответов владельца. "
+                   "Второй источник передан как данные с номером ответа и номером кандидата. Сверяй утверждение "
+                   "кандидата с самим ответом. Для противоречия нужны несовместимые исходы для одного условия: "
+                   "один подтверждён ответом, другой — продолжающим действовать пунктом ТЗ. Ответ не обязан встречаться "
+                   "в исходном ТЗ. Согласованный ответ или явная замена единственного прежнего правила не образуют "
+                   "коллизию. Само новое пожелание не доказывает противоречия. Цитаты со строками бери из ТЗ.")
+        user += "\n\nОтветы владельца к указанным кандидатам (JSON)\n" + json.dumps(owner_answers, ensure_ascii=False)
     try:
         return [_ask(ctx, system, user, response_schema())]
     except Exception as exc:  # noqa: BLE001
diff --git a/tests/v2/test_10_judge.py b/tests/v2/test_10_judge.py
