@@ -0,0 +1,23 @@
+import pytest
+
+from bcc_review.v2.web import onboarding
+
+
+@pytest.mark.parametrize("prefix", ["AQ.", "AIza"])
+def test_welcome_sends_both_google_key_formats_to_verification(prefix, monkeypatch):
+    monkeypatch.setattr(onboarding, "_verified", set())
+    monkeypatch.delenv("GEMINI_API_KEY", raising=False)
+    key = prefix + "unit" * 4
+    calls = []
+
+    def verify(provider, value):
+        calls.append((provider, value))
+        return True, "ok"
+
+    status, reply = onboarding.handle_key(
+        {"provider": "auto", "key": key, "remember": False}, verify=verify
+    )
+
+    assert status == 200 and reply["ok"]
+    assert calls == [("gemini", key)]
+    assert not reply["remembered"]
