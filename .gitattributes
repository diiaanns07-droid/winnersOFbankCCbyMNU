* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
# Входы с фиксированным SHA-256: байты не трогаем
contracts/examples/*.md -text
tests/**/fixtures/** -text
*.pdf binary
*.docx binary
*.png binary
release/input/** -text

# Архив GitHub («Download ZIP», git archive): git вписывает в этот файл хеш коммита — паспорт отчёта без .git
src/bcc_review/v2/COMMIT export-subst

# Запуск одной командой (№42): Windows-файлы — CRLF, unix-скрипты — LF (иначе bash не запустит «#!...\r»)
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.command text eol=lf
