{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diiaanns07-droid/winnersOFbankCCbyMNU/contracts/v1.json",
  "title": "BCC requirements review report, contract v1",
  "description": "Канонический Report. Markdown, HTML, PDF, DOCX и Jira строятся из этого объекта.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run": {
      "$ref": "#/$defs/Run"
    },
    "document": {
      "$ref": "#/$defs/Document"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Requirement"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Check"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Fact"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Coverage"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChecklistRow"
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestCase"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Decision"
      }
    },
    "diff": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/Diff"
        }
      ]
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "block_ids",
          "reason"
        ],
        "additionalProperties": true
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          }
        },
        "required": [
          "candidate",
          "reason"
        ],
        "additionalProperties": true
      }
    }
