# Настройки агента bcc-review.
# Скопируйте этот файл в .env (он в .gitignore и в git не попадёт) и впишите свой ключ.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# Переменные окружения сильнее файла .env. Кавычки вокруг значений не нужны.
# Ключей в этом файле нет и быть не должно.
# Строки с «#» в начале — необязательные настройки со значениями по умолчанию: уберите «#», чтобы изменить.
#
# Провайдер выбирается флагом --provider (по умолчанию auto):
#   есть GEMINI_API_KEY -> gemini; ANTHROPIC_API_KEY -> anthropic; OPENAI_BASE_URL -> openai;
#   установлен `claude` -> claude_cli; иначе offline (только правила, без модели).
# Проверить настройку: python -m bcc_review doctor   (с пробным вызовом модели: doctor --live)

# ---------------------------------------------------------------------------
# Google Gemini — провайдер по умолчанию (достаточно бесплатного ключа)
# Ключ: https://aistudio.google.com/apikey -> «Create API key»
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Основная модель. 3.6 Flash первой по замерам 27.11: на прогонах жюри после 13:00 все ответы дала 3.6 Flash,
# а 3.8 и 3.7 Flash на 23 из 32 запросов ответили 429/503/504 (до 417 с ожидания на одном прогоне)
GEMINI_MODEL=gemini-3.6-flash
# Запасные модели через запятую: берутся по очереди, если основная перегружена (503), недоступна (404) или
# кончилась её суточная квота (бесплатный ключ: около 20 запросов в сутки на каждую Flash, прогон — 9–10 запросов);
# off — без запасных
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Резерв на суточную квоту: модели, которые пробуются после цепочки выше (по умолчанию — цепочка из кода); off — выкл.
# GEMINI_RESERVE_MODELS=
# Вместо GEMINI_API_KEY можно задать GOOGLE_API_KEY
# GOOGLE_API_KEY=
# Глубина рассуждения: для Gemini 3 — уровень, для Gemini 2.5 — бюджет в токенах; off — не передавать
# GEMINI_THINKING_LEVEL=medium
# GEMINI_THINKING_BUDGET=4096
# GEMINI_TEMPERATURE=
# GEMINI_MAX_OUTPUT_TOKENS=32000
# Одновременных запросов (на бесплатном ключе при частых 429 поставьте 1–2)
# GEMINI_CONCURRENCY=5
# Запросов в минуту к одной модели (бесплатный ключ: 10 у Flash, 15 у Flash-Lite; 0 — без ограничения)
# GEMINI_RPM=10
# Сколько секунд ждать по 429 (Retry-After), прежде чем перейти на запасную модель
# GEMINI_MAX_RATE_WAIT_S=65
# Общий предел времени одного обращения со всеми повторами, с
# GEMINI_TOTAL_TIMEOUT_S=

# ---------------------------------------------------------------------------
# Claude Code CLI (провайдер claude_cli): ключ не нужен, нужна установленная и
# авторизованная команда `claude` (подписка Claude). Модель: opus | sonnet | haiku
# ---------------------------------------------------------------------------
CLAUDE_CLI_MODEL=opus
# Глубина рассуждения: low | medium | high | xhigh | max (пусто — по умолчанию CLI)
# CLAUDE_CLI_EFFORT=
# Запасная модель при перегрузке (по умолчанию sonnet, для sonnet — opus); off — без запасной
# CLAUDE_CLI_FALLBACK_MODEL=sonnet
# Путь к программе claude, если её нет в PATH
# CLAUDE_CLI_BIN=
# Нижняя граница таймаута одного вызова, с
# CLAUDE_CLI_TIMEOUT_S=600
# Предел длины ответа claude -p в токенах (рассуждения входят в предел). Пусто — агент ставит
# не меньше 64000, чтобы длинный ответ этапа не обрезался
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# ---------------------------------------------------------------------------
# Claude API (провайдер anthropic): https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_MAX_TOKENS=32000
# Глубина рассуждения: low | medium | high | xhigh | max
# ANTHROPIC_EFFORT=high

# ---------------------------------------------------------------------------
# OpenAI-совместимый сервер (провайдер openai): закрытый контур банка
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=qwen3:32b
#   vLLM:       OPENAI_BASE_URL=http://localhost:8000/v1
#   LM Studio:  OPENAI_BASE_URL=http://localhost:1234/v1
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1  (нужен OPENAI_API_KEY)
# Для локальных серверов ключ обычно не нужен.
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
# Формат ответа: json_schema | json_object | none (если сервер не умеет json_schema, агент откатится сам)
# OPENAI_RESPONSE_FORMAT=json_schema
# OPENAI_TEMPERATURE=0
# OPENAI_MAX_TOKENS=16000
