# Настройки агента bcc-review.
# Скопируйте этот файл в .env (он в .gitignore и в git не попадёт) и впишите свой ключ.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# Переменные окружения сильнее файла .env. Кавычки вокруг значений не нужны.
# Ключей в этом файле нет и быть не должно.

# ---------------------------------------------------------------------------
# Google Gemini — провайдер по умолчанию (достаточно бесплатного ключа)
# Ключ: https://aistudio.google.com/apikey -> «Create API key»
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Основная модель
GEMINI_MODEL=gemini-3.8-flash
# Запасные модели через запятую: берутся по очереди, если основная перегружена (503) или недоступна (404)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Claude API (провайдер anthropic): https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Глубина рассуждения: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# ---------------------------------------------------------------------------
# Claude Code CLI (провайдер claude_cli): ключ не нужен, нужна установленная и
# авторизованная команда `claude` (подписка Claude). Модель: opus | sonnet | haiku
# ---------------------------------------------------------------------------
CLAUDE_CLI_MODEL=opus
CLAUDE_CLI_EFFORT=

# ---------------------------------------------------------------------------
# OpenAI-совместимый сервер (провайдер openai): закрытый контур банка
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=qwen3:32b
#   vLLM:       OPENAI_BASE_URL=http://localhost:8000/v1
#   LM Studio:  OPENAI_BASE_URL=http://localhost:1234/v1
# Для локальных серверов ключ обычно не нужен.
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Общие настройки
# ---------------------------------------------------------------------------
# Провайдер по умолчанию: auto | gemini | anthropic | claude_cli | openai | offline | mock
# auto: есть GEMINI_API_KEY -> gemini; ANTHROPIC_API_KEY -> anthropic; OPENAI_BASE_URL -> openai;
#       установлен `claude` -> claude_cli; иначе offline (только правила, без модели)
BCC_PROVIDER=auto
# Каталог кэша ответов модели (повторный прогон того же документа не тратит вызовы)
BCC_CACHE_DIR=.bcc_cache
