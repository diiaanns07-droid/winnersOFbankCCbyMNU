{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bcc_review/bank_pack/1",
  "title": "Пакет №10: банковский чек-лист и приёмочные сценарии (Report.checklist, Report.test_cases)",
  "description": "Пакет №10 поверх контракта v1 (bcc_review.contracts: ChecklistRow, TestCase, Question, Warning). Поля сверх контракта — для отчётов №13/№17. Списки без записей — пустые массивы.",
  "type": "object",
  "required": [
    "checklist",
    "test_cases",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "checklist": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChecklistRow"
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestCase"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    }
  },
  "$defs": {
    "Evidence": {
      "type": "object",
      "required": [
        "block_id",
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "Mark": {
      "enum": [
        "yes",
        "no",
        "na",
        "unknown"
      ]
    },
    "Change": {
      "type": "object",
      "required": [
        "field",
        "before",
        "after",
        "reason"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "before": {},
        "after": {},
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Question": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "prompt",
        "options",
        "finding_ids",
        "affected_req_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "approval",
            "outcome"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "type": "string"
        },
        "affected_req_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "existing": {
          "type": "boolean"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "ChecklistRow": {
      "type": "object",
      "required": [
        "id",
        "position",
        "text",
        "source_note",
        "available",
        "checked",
        "cells",
        "note",
        "finding_ids",
        "evidence",
        "allowed",
        "source_value",
        "topic",
        "presence",
        "machine",
        "approval",
        "not_required_basis",
        "status",
        "question",
        "changes",
        "source",
        "method"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CHK-\\d{2,}$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_note": {
          "type": "string"
        },
        "available": {
          "$ref": "#/$defs/Mark",
          "description": "Отметка контракта v1 (CHECK_MARKS)"
        },
        "checked": {
          "$ref": "#/$defs/Mark",
          "description": "Отметка контракта v1; unknown — требует подтверждения или не определено"
        },
        "note": {
          "type": "string"
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "allowed": {
          "type": "object",
          "required": [
            "available",
            "checked"
          ],
          "properties": {
            "available": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "checked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source_value": {
          "type": "object"
        },
        "topic": {
          "type": [
            "string",
            "null"
          ]
        },
        "presence": {
          "type": [
            "object",
            "null"
          ]
        },
        "machine": {
          "type": [
            "object",
            "null"
          ]
        },
        "approval": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "role": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "requires_confirmation",
                "recorded",
                "confirmed",
                "rejected",
                "not_required"
              ]
            },
            "basis": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Evidence"
              }
            },
            "decision_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "not_required_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "filled",
            "needs_confirmation",
            "undetermined"
          ]
        },
        "question": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Question"
            }
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Change"
          }
        },
        "source": {
          "type": "object",
          "required": [
            "block_id",
            "evidence",
            "location",
            "columns"
          ],
          "properties": {
            "block_id": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/Evidence"
            },
            "location": {
              "type": "string"
            },
            "columns": {
              "type": "object"
            },
            "cells": {
              "type": "object"
            }
          }
        },
        "method": {
          "enum": [
            "rules",
            "llm"
          ]
        },
        "cells": {
          "type": "object",
          "required": [
            "available",
            "checked"
          ],
          "description": "Исходные токены шаблона («Да», «Нет», «Не требуется»…) или null",
          "properties": {
            "available": {
              "$ref": "#/$defs/Token"
            },
            "checked": {
              "$ref": "#/$defs/Token"
            }
          }
        }
      }
    },
    "Option": {
      "type": "object",
      "required": [
        "id",
        "label",
        "expected",
        "basis"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "chosen": {
          "type": "boolean"
        }
      }
    },
    "TestCase": {
      "type": "object",
      "required": [
        "id",
        "key",
        "kind",
        "level",
        "title",
        "precondition",
        "action",
        "expected",
        "gherkin",
        "req_ids",
        "source_ids",
        "obligation",
        "evidence",
        "values",
        "status",
        "open_question_id",
        "open_question",
        "options",
        "decision_id",
        "resolved_question_id",
        "finding_ids",
        "covers_gaps",
        "needs_clarification",
        "source",
        "notes",
        "changes",
        "draft"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC-\\d{2,}$"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "level": {
          "enum": [
            "business",
            "api"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "precondition": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "gherkin": {
          "type": "string"
        },
        "req_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "obligation": {
          "type": "object",
          "required": [
            "req_id",
            "source_id",
            "quote",
            "evidence"
          ],
          "properties": {
            "req_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "quote": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/Evidence"
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "values": {
          "type": "object"
        },
        "status": {
          "enum": [
            "draft",
            "open",
            "agreed"
          ]
        },
        "open_question_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "open_question": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Question"
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "decision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_question_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "covers_gaps": {
          "type": "array"
        },
        "needs_clarification": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "rules",
            "acceptance_table",
            "witness",
            "coverage",
            "llm"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Change"
          }
        },
        "draft": {
          "type": "boolean"
        }
      }
    },
    "Warning": {
      "description": "Строка контракта Warning (русское сообщение); код — в BankWarning.code. Отказ модели начинается с «bank: ».",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "Token": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
