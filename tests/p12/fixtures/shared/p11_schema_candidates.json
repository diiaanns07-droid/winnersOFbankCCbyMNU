{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p11-test: черновик семантического этапа (Candidate + hints)",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "requirement",
              "set"
            ]
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string"
          },
          "req_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/hint"
            }
          },
          "inspected_block_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "scope",
          "kind",
          "criterion",
          "severity",
          "title",
          "impact",
          "req_ids",
          "hints",
          "inspected_block_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "candidates"
  ],
  "additionalProperties": false,
  "$defs": {
    "hint": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "block_id",
        "quote"
      ],
      "additionalProperties": false
    }
  }
}
