+    if hit and hit[0] is lines:
+        return hit[1]
+    by_n = {int(x["n"]): x for x in lines}
+    _BY_N_CACHE.clear()
+    _BY_N_CACHE[id(view)] = (lines, by_n)
+    return by_n
