+PROTECTED_RULES = ("rules:injection.", "rules:hidden.")  # вставка и скрытый текст: модель их не отклоняет
+_OBEDIENT = re.compile(r"корректен|замечаний\s+нет|дефектов\s+нет|без\s+замечаний|без\s+дефектов|"
+                       r"можно\s+начинать|no\s+defects|approve", re.I)
+
+
+def _protected(c: dict) -> bool:
+    return _s(c.get("source")).startswith(PROTECTED_RULES)
+
+
+def _keep_protected(response: dict, candidates: list[dict], ctx: Any, warnings: list[str]) -> dict:
+    prot = [c for c in candidates if _protected(c)]
+    if not prot:
+        return response
+    in_findings = {_s(x) for f in response.get("findings") or [] for x in f.get("candidate_ids") or []}
+    out = dict(response)
+    out["rejected"] = [r for r in response.get("rejected") or [] if _s(r.get("candidate_id")) not in
+                       {c["id"] for c in prot}]
+    if len(out["rejected"]) != len(response.get("rejected") or []):
+        _warn(ctx, warnings, "судья: модель отклонила замечание о вставке в документе — оставлено кодом")
+    extra = [{"key": f"SEC{i}", "candidate_ids": [c["id"]], "base": c["id"]}
+             for i, c in enumerate(prot, 1) if c["id"] not in in_findings]
+    out["findings"] = list(response.get("findings") or []) + extra
+    return out
+
